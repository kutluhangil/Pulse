---
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import PhoneHero from '../components/PhoneHero.astro';
import Tour from '../components/Tour.astro';
import Sections from '../components/Sections.astro';
---

<Base
  title="Pulse · your home server, live in your menu bar"
  description="Free, open-source monitor for a home server: a menu bar app for macOS, a GTK app for Linux and a tiny Go agent. CPU, temperature, memory, disk, network and Docker, every second, over Tailscale."
>
  <Story />
  <PhoneHero />
  <main>
    <Tour />
    <Sections />
  </main>
</Base>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>
