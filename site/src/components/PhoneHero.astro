---
// Phones get a still hero instead of the scaled scroll story.
import Scenery from './Scenery.astro';
import { links } from '../data/release';
---

<section class="phone-hero" aria-label="Pulse">
  <div class="card">
    <Scenery kind="sky" class="bg" />
    <div class="top">
      <span class="logo"><img src="/mark.png" alt="" width="28" height="28" />Pulse</span>
      <a href="#download">Download</a>
    </div>
    <h1 class="serif">Your home server,<br />live in your menu bar.<br /><em>Every second, every container.</em></h1>
    <a class="cta" href={links.releases}>Get Pulse for macOS or Linux</a>
    <img src="/shots/panel.png" alt="The Pulse panel: health 98, CPU, temperature, memory, disk, network, fan and containers" width="340" height="765" loading="eager" />
  </div>
</section>

<style>
  .phone-hero {
    display: none;
    padding: 10px;
  }
  .card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: 22px 20px 0;
    color: #fff;
    min-height: 92svh;
    isolation: isolate;
    background: #14306a;
  }
  .card :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    display: flex;
    gap: 9px;
    align-items: center;
    font-weight: 600;
    font-size: 19px;
  }
  .logo img {
    width: 30px;
    height: 30px;
  }
  .top a {
    background: #fff;
    color: #111521;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    padding: 11px 16px;
    border-radius: 9px;
  }
  h1 {
    margin-top: 64px;
    font-size: clamp(36px, 10.5vw, 46px);
    line-height: 1.04;
    text-align: center;
  }
  h1 em {
    color: #cfe0fb;
  }
  .cta {
    display: block;
    margin: 28px auto 0;
    width: max-content;
    background: #fff;
    color: #111521;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    padding: 16px 22px;
    border-radius: 10px;
  }
  img {
    width: min(320px, 82%);
    height: auto;
    margin: 36px auto 0;
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -10px 50px -20px rgba(0, 0, 0, 0.6);
  }
  @media (max-width: 760px) {
    .phone-hero {
      display: block;
    }
  }
</style>
