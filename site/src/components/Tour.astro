---
// Live tour: the app itself, clickable, in an iframe (/tour/), with a system switch.
const steps = [
  ['Click the server', 'in the menu bar to open the panel'],
  ['Right-click it', 'for the tools menu'],
  ['Open a container', 'to read its last log lines'],
  ['Change a setting', 'the icon and alerts follow'],
];
---

<section class="section tour" id="tour" aria-labelledby="tour-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Live tour</p>
        <h2 id="tour-title">Click through it, <em>right here.</em></h2>
      </div>
      <p>This is the app, running in your browser on made-up numbers. Your real server never faces the internet: Pulse reaches it over your tailnet.</p>
    </header>

    <div class="switch" role="tablist" aria-label="System" data-reveal>
      <button role="tab" aria-selected="true" data-os="mac">macOS</button>
      <button role="tab" aria-selected="false" data-os="linux">Linux</button>
    </div>

    <div class="frame" data-reveal>
      <iframe title="Pulse live tour" data-src="/tour/" loading="lazy"></iframe>
    </div>

    <ol class="steps" data-reveal>
      {steps.map(([a, b], i) => <li><span>{String(i + 1).padStart(2, '0')}</span><b>{a}</b> {b}</li>)}
    </ol>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('.tour iframe')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tour .switch button')];
  const load = (os: string) => {
    frame.src = `${frame.dataset.src}?os=${os}`;
    buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.os === os)));
  };
  buttons.forEach((b) => b.addEventListener('click', () => load(b.dataset.os!)));
  new IntersectionObserver((entries, obs) => {
    if (entries.some((e) => e.isIntersecting)) {
      load('mac');
      obs.disconnect();
    }
  }, { rootMargin: '400px' }).observe(frame);
</script>

<style>
  .switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line);
    margin-bottom: 18px;
  }
  .switch button {
    border: 0;
    background: none;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-3);
    padding: 10px 18px;
    border-radius: 9px;
    cursor: pointer;
  }
  .switch button[aria-selected='true'] {
    background: var(--btn);
    color: #fff;
  }
  .frame {
    border-radius: 28px;
    overflow: hidden;
    background: #10203f;
    aspect-ratio: 16 / 10;
    box-shadow: 0 40px 80px -50px rgba(10, 30, 70, 0.6);
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin-top: 26px;
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .steps span {
    display: block;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .steps b {
    color: var(--ink);
    font-weight: 500;
  }
  @media (max-width: 820px) {
    .frame {
      aspect-ratio: 9 / 14;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
