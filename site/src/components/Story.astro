---
// The scroll story (design architecture from the Floo.design landing, rebuilt
// for Pulse): on load the sky opens and the headline lands line by line; the
// scroll then lifts the dashboard out of the hills, folds the hero into a
// header and plays two tab stories (macOS, Linux). 1440 x 1036 design, scaled.
import '../styles/story.css';
import Scenery from './Scenery.astro';
import { brandPath } from '../lib/icons';
import { links, repo } from '../data/release';

const containers = [
  { l: 'j', c: '#2fb57a', n: 'jellyfin' },
  { l: 's', c: '#2fb57a', n: 'samba' },
  { l: 'c', c: '#e2a20f', n: 'cloudflared' },
  { l: 'p', c: '#2fb57a', n: 'portainer' },
];
const menu = ['Open Pulse', 'Settings…', 'SSH into Server', 'Portainer', 'Cockpit', 'Container Logs', 'Copy Status Summary'];
const ints = [
  { b: 'docker', t: 'Docker', s: '9 containers' },
  { b: 'tailscale', t: 'Tailscale', s: 'tailnet only' },
  { b: 'ubuntu', t: 'Ubuntu', s: 'any Linux server' },
  { b: 'portainer', t: 'Portainer', s: 'one click away' },
  { b: 'cockpit', t: 'Cockpit', s: 'one click away' },
  { b: 'linux', t: 'Linux desktop', s: 'GTK 4 + tray' },
] as const;
---

<section class="story" id="top" data-story aria-label="Pulse">
  <div class="viewport">
    <div class="stage" data-stage>
      <section class="hero" data-k="hero">
        <div class="scene" data-k="scene">
          <Scenery kind="sky" class="sky" />
          <div class="crm" data-k="crm">
            <div class="who">
              <span class="sun"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" /></svg></span>
              <div><b>macmini-server</b><small>Ubuntu 24.04 · up 6d 9h</small></div>
            </div>
            <div class="board"><em>Health</em><span data-sim="score">98</span><i>Excellent</i></div>
            <div class="sc s1">
              <span class="lb">Resources</span><span class="ct live"><i></i>live</span>
              <div class="num n1"><span data-sim="cpu">6</span><u>%</u><small>cpu · idle</small></div>
              <div class="num n2"><span data-sim="temp">53</span><u>°</u><small>normal</small></div>
              <div class="num n3"><span data-sim="mem">8</span><u>%</u><small>of 16 GB</small></div>
            </div>
            <div class="sc s2">
              <span class="lb">Network</span><span class="ct">↓ ↑</span>
              <div class="big" data-sim="rx">2 KB/s</div>
              <svg class="spark" viewBox="0 0 210 46" preserveAspectRatio="none"><path data-sim="spark-fill" d="" /><path data-sim="spark" d="" /></svg>
            </div>
            <div class="avs">
              {containers.map((c, i) => <i style={`top:${15 + i * 38}px;--c:${c.c}`} title={c.n}>{c.l}</i>)}
              <span class="more">+5</span>
            </div>
            <div class="chat">
              <div class="msg" style="left:14px;top:15px;width:268px">
                <div class="t">Pulse <span>#alerts</span><svg class="i" viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0-6 6v3.6L4.3 16h15.4L18 12.6V9a6 6 0 0 0-6-6zm-2 15a2 2 0 0 0 4 0z" /></svg></div>
                <p><b>macmini-server</b> is running hot · CPU at 86 °C</p>
              </div>
              <div class="lookup" style="right:17px;top:72px"><svg class="i" data-k="spin" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9" /></svg>Watching for 30 s</div>
              <div class="found" data-k="found" style="left:56px;top:100px;width:226px">
                <p>Resolved ✅</p>
                <p>Cooled down to 61 °C in two minutes.</p>
                <p>No alerts open. Every container healthy.</p>
              </div>
            </div>
            <div class="cur" data-k="cur"><svg viewBox="0 0 16 16"><path d="M2 1.5l11.5 6.2-5.2 1.3-2.4 4.9z" /></svg><span>You</span></div>
          </div>
          <Scenery kind="hills" class="grass" />
        </div>

        <nav class="nav" data-k="nav">
          <a class="logo" data-k="logo" href="#top" aria-label="Pulse home">
            <svg class="tile" viewBox="0 0 28 28"><defs><linearGradient id="lg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3f7fe0" /><stop offset="1" stop-color="#143a7a" /></linearGradient></defs><rect width="28" height="28" rx="8" fill="url(#lg)" /><path d="M4.5 15h4.2l2.1-5 3.2 9.5 2.6-6.5 1.4 2h5.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="wm">Pulse</span>
          </a>
          <div class="pill">
            <a class="pb on" href="#top" aria-label="Top"><svg class="i" viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" /></svg></a>
            <a class="pb" href="#tour" aria-label="Live tour"><svg class="i" viewBox="0 0 24 24"><path d="M3 12h4l2.5-6 4 12 2.5-6H21" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <a class="pb" href={links.dmg} aria-label="Download for macOS"><svg class="i" viewBox="0 0 24 24"><path d={brandPath('apple')} /></svg></a>
            <a class="pb" href={links.deb} aria-label="Download for Linux"><svg class="i" viewBox="0 0 24 24"><path d={brandPath('linux')} /></svg></a>
            <a class="pb soft" href={repo} aria-label="Source on GitHub"><svg class="i" viewBox="0 0 24 24"><path d={brandPath('github')} /></svg></a>
          </div>
          <a class="wl" href="#download">Download</a>
        </nav>

        <div class="badge" data-k="badge">Free and open source <span class="mk"><svg class="i" viewBox="0 0 24 24"><path d={brandPath('github')} /></svg></span><span class="mono">macOS · Linux · GPL-3.0</span></div>
        <h1 class="h1 serif" data-k="h1"><span>Your home server,</span><span>live in your menu bar.</span><span>Every second, every container.</span></h1>
        <a class="cta" data-k="cta" href="#download">Download Pulse</a>
        <div class="hint" data-k="hint"><i></i></div>
        <h2 class="h2 serif" data-k="h2"><span>Your server,</span><span>one glance away.</span></h2>
      </section>

      <section class="panel" data-k="panel">
        <div class="tabs" data-k="tabs">
          <button class="tab" data-k="tab0" style="left:33px"><b>macOS</b><small>Menu bar, panel, alerts</small></button>
          <button class="tab off" data-k="tab1" style="left:207px"><b>Linux</b><small>GTK 4 window and tray</small></button>
          <a class="tab off" href="#agent" style="left:376px"><b>Agent</b><small>One Go binary</small></a>
          <a class="tab off" href="#tour" style="left:527px"><b>Live tour</b><small>Click through it here</small></a>
          <div class="bar" data-k="bar0" style="left:0;width:191px"><i></i></div>
          <div class="bar" data-k="bar1" style="left:191px;width:172px"><i></i></div>
          <div class="bar" style="left:363px;width:151px"><i></i></div>
          <div class="bar" style="left:514px;width:183px"><i></i></div>
        </div>
        <div class="copy" data-k="copyA">
          <h3 class="serif">On your Mac</h3>
          <p>A little server in the menu bar hops faster when the<br />machine works harder. Click for the panel, right-click<br />for the tools menu, and hear about trouble first.</p>
          <a href={links.dmg}>Download for macOS</a>
        </div>
        <div class="copy" data-k="copyB">
          <h3 class="serif">On Linux</h3>
          <p>The same live numbers in a native GNOME window,<br />with a tray icon on Ubuntu and KDE. One package<br />for amd64 and arm64, built on GTK 4.</p>
          <a href={links.deb} style="padding:0 36px">Get the .deb</a>
        </div>
      </section>

      <section class="pic" data-k="pic">
        <Scenery kind="valley" class="rock" />
        <div class="glass" data-k="glass">
          <div class="mbar">
            <span class="apple"><svg class="i" viewBox="0 0 24 24"><path d={brandPath('apple')} /></svg></span>
            <span class="mb-r">
              <canvas data-sprite="server" data-ink="#1b1f27" data-health="#2fb57a" width="40" height="36"></canvas>
              <span class="mono" data-sim="menubar">53° 6%</span>
              <span class="clock">Fri 21:14</span>
            </span>
          </div>
          <ul class="menu" data-k="menu">
            {menu.map((m, i) => <li style={`--i:${i}`}>{m}{m === 'Container Logs' && <span>›</span>}</li>)}
          </ul>
          <div class="msg" data-k="gmsg" style="left:22px;top:196px;width:305px;background:#fff">
            <div class="t">Pulse <span>notification</span></div>
            <p>Container <b>jellyfin</b> needs attention</p>
          </div>
          <div class="lookup" data-k="glook" style="right:22px;top:250px"><svg class="i" data-k="spin2" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9" /></svg>Restart policy kicked in</div>
          <div class="found" data-k="gfound" style="left:70px;top:278px;width:257px">
            <p>Recovered ✅</p>
            <p>jellyfin is healthy again after 40 s.</p>
          </div>
        </div>
        <div data-k="intg">
          <div class="ints">
            {ints.map((x) => (
              <div class="int">
                <span class="ic"><svg class="i" viewBox="0 0 24 24"><path d={brandPath(x.b)} /></svg></span>
                <div><b>{x.t}</b><small>{x.s}</small></div>
              </div>
            ))}
          </div>
          <div class="wire" data-k="wire"></div>
          <div class="ai" data-k="ai"><div><span><svg class="i" viewBox="0 0 24 24"><path d={brandPath('go')} /></svg></span><b>pulse-agent</b><span><svg class="i" viewBox="0 0 24 24"><path d={brandPath('docker')} /></svg></span></div></div>
        </div>
        <Scenery kind="valley-fg" class="rockfg" />
      </section>
    </div>
  </div>
</section>

<script>
  import { start } from '../scripts/story';
  start();
</script>
