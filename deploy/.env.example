# Copy to deploy/.env (git-ignored). deploy.sh creates it for you with a fresh token.
# Bearer token the macOS app sends. Generate: openssl rand -hex 32
PULSE_TOKEN=
# Public endpoints to check every minute: name=url,name=url
PULSE_PROBES=perde=https://perde.kutluhangil.dev,perde-keys=https://perde-keys.kutluhangil.dev/health
