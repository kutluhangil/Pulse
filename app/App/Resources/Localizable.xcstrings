{
  "sourceLanguage": "en",
  "strings": {
    "About Pulse": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse hakkında"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri denetle…"
          }
        }
      }
    },
    "Click to download it from GitHub.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'dan indirmek için tıklayın."
          }
        }
      }
    },
    "Container Logs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konteyner günlükleri"
          }
        }
      }
    },
    "Copy Status Summary": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum özetini kopyala"
          }
        }
      }
    },
    "Could not check for updates": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeler denetlenemedi"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndir"
          }
        }
      }
    },
    "For 1 Hour": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 saat"
          }
        }
      }
    },
    "For 8 Hours": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "8 saat"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra"
          }
        }
      }
    },
    "Open Pulse": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse'u aç"
          }
        }
      }
    },
    "Open Site": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siteyi aç"
          }
        }
      }
    },
    "Pause Notifications": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimleri duraklat"
          }
        }
      }
    },
    "Pulse %@ is available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse %@ çıktı"
          }
        }
      }
    },
    "Pulse Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Ayarları"
          }
        }
      }
    },
    "Pulse is up to date": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse güncel"
          }
        }
      }
    },
    "Quit Pulse": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse'tan çık"
          }
        }
      }
    },
    "Reconnect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden bağlan"
          }
        }
      }
    },
    "Release Notes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm notları"
          }
        }
      }
    },
    "Resume Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi sürdür"
          }
        }
      }
    },
    "SSH into Server": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya SSH ile bağlan"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar…"
          }
        }
      }
    },
    "Until Tomorrow": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın sabaha kadar"
          }
        }
      }
    },
    "Update to Pulse %@…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse %@ sürümüne güncelle…"
          }
        }
      }
    },
    "Version %@ is the latest release.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en son sürüm."
          }
        }
      }
    },
    "You have %@. Open the disk image and drag Pulse to Applications.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizdeki sürüm %@. Disk görüntüsünü açıp Pulse'u Uygulamalar'a sürükleyin."
          }
        }
      }
    }
  },
  "version": "1.0"
}
